# Postgres container (docker-compose.yml)
POSTGRES_USER=training
POSTGRES_PASSWORD=training
POSTGRES_DB=training_db
POSTGRES_PORT=5433

# Prisma (phải khớp với các giá trị Postgres ở trên)
DATABASE_URL="postgresql://training:training@localhost:5433/training_db?schema=public"

# Admin được seed (đổi mật khẩu nếu dùng ngoài môi trường training)
ADMIN_EMAIL="admin@example.com"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="Admin@123456"

PORT=3000
HOST=127.0.0.1

# Generate a real secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-this-example-secret-with-a-random-48-byte-value"
JWT_EXPIRES_IN=15m
