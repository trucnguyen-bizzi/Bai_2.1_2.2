{
  "name": "auth-training",
  "version": "1.0.0",
  "private": true,
  "description": "Training Week 1 Day 2 - Exercise 2.1: Postgres + Prisma",
  "scripts": {
    "typecheck": "prisma generate && tsc --noEmit",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:verify": "tsx scripts/verify-db.ts",
    "setup": "npm run db:generate && npm run db:up && npm run db:deploy && npm run db:seed && npm run db:verify",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "lint": "eslint . && prettier --check \"**/*.{ts,mjs,json}\"",
    "lint:fix": "eslint . --fix && prettier --write \"**/*.{ts,mjs,json}\"",
    "format": "prettier --write \"**/*.{ts,mjs,json}\"",
    "check": "npm run lint && npm run typecheck && npm run test",
    "test": "jest tests/unit",
    "test:integration": "jest tests/integration --runInBand"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/jwt": "^10.2.2",
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.5",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "joi": "^18.2.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "prettier": "^3.9.9",
    "prisma": "^6.19.3",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "setupFiles": [
      "dotenv/config"
    ]
  }
}
